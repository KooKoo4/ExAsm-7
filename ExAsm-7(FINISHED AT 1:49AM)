%include "io64.inc"

default rel

extern GetStdHandle
extern WriteFile
extern ExitProcess

section .data
number dq 172
mastercard dq 50

odd db 'Odd number, ', 0
msg_len3 equ $ -odd

even db 'Even number, ', 0
msg_len4 equ $ -even

nmcmsg db ', Access Denied, ', 0
msg_len2 equ $ -nmcmsg

mcmsg db ', Access Granted, ', 0

msg_len equ $ -mcmsg

newvalueodd dq 0
newvalueeven dq 0
newvaluehigh dq 0
newvalueequal dq 0
newvaluelow dq 0

higheven dq 122
equaleven dq 72
loweven dq 22
highodd dq 111
equalodd dq 61
lowodd dq 11

section .bss
bytes_written resq 1


section .text
global main
main: 

        sub rsp, 40

    mov rax, [number]
    and rax, 1
    jz .even
    jmp .odd
    
    ;----------------------------
    
        ;PARITY[
        cmp rax, [mastercard]
        and rax, 1
        jz .odd
        jmp .even
        
        .odd:
        mov qword [newvalueodd], 0
        xor rax, rax
        mov ecx, -11
        call GetStdHandle
        mov rbx, rax
        mov rcx, rbx
        lea rdx, [odd]
        mov r8, msg_len3
        lea r9, [bytes_written]
        mov qword [rsp + 32], 0
        call WriteFile
        mov rax, 11
        jmp .oddstor
        
        .even:
        mov qword [newvalueeven], 0
        xor rax, rax
        mov ecx, -11
        call GetStdHandle
        mov rbx, rax
        mov rcx, rbx
        lea rdx, [even]
        mov r8, msg_len4
        lea r9, [bytes_written]
        mov qword [rsp + 32], 0
        call WriteFile
        mov rax, 22
        jmp .evenstor ;]
        
        ;-------------------------
        
        
        ;ODD OR EVEN STORE[
        
        .oddstor:
        mov [newvalueodd], rax
        PRINT_DEC 8, rax
        jmp .VALUECHECKER
        

     
        
        .evenstor:
        mov [newvalueeven], rax
         PRINT_DEC 8, rax
        jmp .VALUECHECKER ;]
       
        
      ;------------------------------  
        
        ;VALUE[
        .VALUECHECKER:
        mov rax, [number]
        cmp rax, [mastercard]
        jg .High
        je .Equal
        jmp .Low ;]
        
        
        .High:
        mov qword [newvaluehigh], 0
        xor rax, rax
            mov rax, 100
            mov [newvaluehigh], rax
            PRINT_DEC 8, [newvaluehigh]
            jmp .Criteria
            
    
        
        .Equal:
        mov qword [newvalueequal], 0
        xor rax, rax
            mov rax, 50
            mov [newvalueequal], rax
        PRINT_DEC 8, [newvalueequal]
            jmp .Criteria
       
        
        
        
        .Low:
        mov qword [newvaluelow], 0
        xor rax, rax
            mov rax, 0
            mov [newvaluelow], rax
        PRINT_DEC 8, [newvaluelow]
        jmp .Criteria
        
   ;-----------------------
    
        
        ;CRITERIA
        .Criteria:
        mov rax, [newvaluehigh]
        mov rbx, [newvalueeven]
        add rax, rbx
        cmp rax, [higheven]
        je .ACCESSGRANTED
        jmp .2
        .2:
        mov rax, [newvalueequal]
        mov rbx, [newvalueeven]
        add rax, rbx
        cmp rax, [equaleven]
        je .ACCESSGRANTED
        jmp .3
        .3:
        mov rax, [newvaluelow]
        mov rbx, [newvalueeven]
        add rax, rbx
        cmp rax, [loweven]
        je .ACCESSDENIED
        jmp .4
        .4:
        mov rax, [newvaluehigh]
        mov rbx, [newvalueodd]
        add rax, rbx
        cmp rax, [highodd]
        je .ACCESSDENIED
        jmp .5
        .5:
        mov rax, [newvalueequal]
        mov rbx, [newvalueodd]
        add rax, rbx
        cmp rax, [equalodd]
        je .ACCESSDENIED
        jmp .6
        .6:
        mov rax, [newvaluelow]
        mov rbx, [newvalueodd]
        add rax, rbx
        cmp rax, [lowodd]
        jz .ACCESSDENIED
        jmp .ACCESSDENIED

       
        

        
        
        
        .ACCESSGRANTED:

        mov ecx, -11
        call GetStdHandle
        mov rbx, rax
        mov rcx, rbx
        lea rdx, [mcmsg]
        mov r8, msg_len
        lea r9, [bytes_written]
        mov qword [rsp + 32], 0
        call WriteFile
        jmp .FINISH
        
        
        .ACCESSDENIED:

        mov ecx, -11
        call GetStdHandle
        mov rbx, rax
        mov rcx, rbx
        lea rdx, [nmcmsg]
        mov r8, msg_len2
        lea r9, [bytes_written]
        mov qword [rsp + 32], 0
        call WriteFile
        jmp .FINISH
        
        
        .FINISH:
        xor ecx, ecx
        call ExitProcess
        
        
        
        
        
      
    
    
